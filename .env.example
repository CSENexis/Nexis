# Nexis Environment Configuration
# Copy this to .env and configure as needed

# Environment: development | production | test
ENV=development

# Database configuration (PostgreSQL)
POSTGRES_USER=nexis
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=nexis
DATABASE_URL=postgresql+psycopg://nexis:change_me_to_a_secure_password@localhost:5432/nexis

# Redis configuration (Rate limiting & temporary lockout)
REDIS_URL=redis://localhost:6379/0

# Cryptographic Keys (Must be long and securely generated in production)
# SECRET_KEY for general token hashing and session signing
SECRET_KEY=nexis_super_secure_random_secret_key_at_least_32_bytes_long

# HMAC_KEY for recovery code hashing and integrity checks
HMAC_KEY=nexis_hmac_secret_key_for_recovery_codes_at_least_32_bytes

# Fernet symmetric encryption key for TOTP secrets at rest (44 characters base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=eXxBzHmNDOjXGYpGCrNJTe9Du38J-v2pE34_yULBgko=

# Cookie security settings (Set to true in production with HTTPS per NFR4, A27)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=nexis_session

# Session lifetimes (A40)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
PENDING_MFA_MINUTES=5

# Rate limiting and lockout parameters (FR9, A24, A25)
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_MFA_PER_MINUTE=5
RATE_LIMIT_RECOVERY_PER_MINUTE=5

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
